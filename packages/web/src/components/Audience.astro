---
/** Block 9: who it is for — travellers, developers, business. The footer follows in Base. */
import { t } from "../i18n/index.js";
import { pathFor, type Lang, type PageId } from "../site/pages.js";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cards: readonly { key: "travellers" | "developers" | "business"; page: PageId }[] = [
  { key: "travellers", page: "connect" },
  { key: "developers", page: "developers" },
  { key: "business", page: "business" },
];
---

<section class="block audience" id="audience" aria-labelledby="audience-heading">
  <div class="wrap">
    <div class="block__head">
      <h2 id="audience-heading">{t(lang, "audience.heading")}</h2>
    </div>
    <details class="fold">
      <summary class="fold__summary btn btn--sm">{t(lang, "audience.show")}</summary>
    <div class="grid grid--3">
      {
        cards.map((c) => (
          <article class="card">
            <h3>{t(lang, `audience.${c.key}.title`)}</h3>
            <p>{t(lang, `audience.${c.key}.text`)}</p>
            <a class="btn btn--sm" href={pathFor(c.page, lang)}>{t(lang, `audience.${c.key}.cta`)}</a>
          </article>
        ))
      }
    </div>
    </details>
  </div>
</section>
