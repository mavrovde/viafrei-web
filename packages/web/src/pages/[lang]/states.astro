---
/** `/<lang>/states` — the index of the sixteen Länder (#1074), every language; 503 when the digest does not answer. */
import StatesPage from "../../layouts/StatesPage.astro";
import { isLang } from "../../i18n/index.js";
import { readEnv } from "../../lib/env.js";
import { unavailableAnswer } from "../../lib/degraded.js";
import { resolveStateIndex } from "../../lib/state-page.js";

const lang = Astro.params["lang"] ?? "";
if (!isLang(lang)) return Astro.rewrite("/404");
const env = readEnv();
const a = await resolveStateIndex(lang, { baseUrl: env.digestUrl, timeoutMs: env.tileTimeoutMs });
if (a.kind === "unavailable") return unavailableAnswer(lang, Astro.request);
---

<StatesPage lang={lang} html={a.html} />
