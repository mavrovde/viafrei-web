---
/** `/<lang>/state/<slug>` — one Bundesland's page (#1074): 301 for another spelling of its slug, 404 for no Land, 503 when the digest does not answer. */
import StatePage from "../../../layouts/StatePage.astro";
import { isLang } from "../../../i18n/index.js";
import { readEnv } from "../../../lib/env.js";
import { withinBudget } from "../../../lib/page-budget.js";
import { unavailableAnswer } from "../../../lib/degraded.js";
import { resolveStatePage } from "../../../lib/state-page.js";

const lang = Astro.params["lang"] ?? "";
if (!isLang(lang)) return Astro.rewrite("/404");
const env = readEnv();
const a = await resolveStatePage(lang, Astro.params["slug"] ?? "", withinBudget({ baseUrl: env.digestUrl, timeoutMs: env.tileTimeoutMs, mapPlatform: Astro.locals.mapPlatform }, Astro.locals.budgetEndsAt));
if (a.kind === "missing") return Astro.rewrite("/404");
if (a.kind === "unavailable") return unavailableAnswer(lang, Astro.request);
if (a.kind === "redirect") return Astro.redirect(a.to, 301);
---

<StatePage lang={lang} slug={a.slug} head={a.head} />
